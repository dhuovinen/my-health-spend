{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-health-spend.local/schema/mhs-ingest-0.1.json",
  "title": "My Health Spend ingest file",
  "description": "One ingest batch. Every section is optional, so a file can carry only settings (plans, accounts, providers), only visits and documents, or both. Records are upserted by id: re-importing a file with the same id replaces that record. Money is in dollars and is converted to integer cents on import. Cross-references (provider_id, visit_id and so on) are checked by the importer, not by this schema.",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plan"
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/account"
      }
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "provider_relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider_relationship"
      }
    },
    "provider_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider_note"
      }
    },
    "visits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visit"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/provider_bill"
          },
          {
            "$ref": "#/$defs/eob"
          },
          {
            "$ref": "#/$defs/payment"
          },
          {
            "$ref": "#/$defs/receipt"
          },
          {
            "$ref": "#/$defs/account_reimbursement"
          },
          {
            "$ref": "#/$defs/account_transaction"
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "Stable identifier you choose, e.g. 'v-2026-02-10-pcp'. Used to link records and to upsert on re-import."
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "money": {
      "type": "number",
      "minimum": 0,
      "description": "US dollars, up to 2 decimal places."
    },
    "network_status": {
      "enum": [
        "in_network",
        "out_of_network",
        "not_applicable",
        "unknown"
      ]
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "type": "object",
      "description": "Free-form fields not yet in the schema. Stored as-is; lets the format evolve without breaking imports."
    },
    "file": {
      "type": "string",
      "description": "Path to the source document (PDF or image), relative to the ingest file. A missing file is a warning, not an error."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prepared_by": {
          "type": "string"
        },
        "prepared_on": {
          "$ref": "#/$defs/date"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "plan": {
      "type": "object",
      "description": "Insurance plan for one plan year. Shown and edited on the Settings page.",
      "required": [
        "id",
        "plan_year",
        "insurer"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "plan_year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "insurer": {
          "type": "string"
        },
        "coverage_order": {
          "enum": [
            "primary",
            "secondary",
            "tertiary"
          ],
          "description": "Order this plan pays in when more than one plan covers a member (coordination of benefits)."
        },
        "member_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Household members this plan covers."
        },
        "plan_name": {
          "type": "string"
        },
        "coverage_start": {
          "$ref": "#/$defs/date"
        },
        "coverage_end": {
          "$ref": "#/$defs/date"
        },
        "hsa_eligible_plan": {
          "type": "boolean",
          "description": "True for a high-deductible plan that allows HSA contributions."
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plan_limit"
          },
          "description": "Deductibles and out-of-pocket maximums, one entry per type, network tier and level."
        },
        "coinsurance_rate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Your share after the deductible, e.g. 0.2 for 20%. null when not yet known."
        },
        "copays": {
          "type": "object",
          "description": "Copay by service type, e.g. {\"primary_care\": 30, \"specialist\": 60}.",
          "additionalProperties": {
            "$ref": "#/$defs/money"
          }
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "appeal_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "description": "Days after an EOB to appeal it to the insurer (DSP-05). Default 180, the ACA minimum for internal appeals."
        }
      }
    },
    "account": {
      "type": "object",
      "description": "A way of paying. Shown and edited on the Settings page.",
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "description": "A label, not an account number, e.g. 'HSA' or 'Personal Visa'."
        },
        "type": {
          "enum": [
            "hsa",
            "fsa",
            "lpfsa",
            "hra",
            "credit_card",
            "debit_card",
            "bank",
            "cash",
            "other"
          ],
          "description": "fsa is a general-purpose health FSA; lpfsa a limited-purpose (dental and vision) FSA; hra a health reimbursement arrangement."
        },
        "plan_year": {
          "type": "integer",
          "description": "For FSAs and other per-year accounts."
        },
        "opened": {
          "$ref": "#/$defs/date",
          "description": "When an HSA was established; expenses before it can't be reimbursed from it (TAX-04)."
        },
        "member_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "The account holder first (HSA), or the participants (FSA, HRA)."
        },
        "plan_year_start": {
          "$ref": "#/$defs/date",
          "description": "First day of an FSA's or HRA's plan year (default: January 1 of plan_year)."
        },
        "plan_year_end": {
          "$ref": "#/$defs/date",
          "description": "Last day of the plan year (default: December 31 of plan_year)."
        },
        "grace_period": {
          "type": "boolean",
          "description": "The plan year's money pays expenses through the 15th of the third month after it ends (TAX-02)."
        },
        "carryover": {
          "$ref": "#/$defs/money",
          "description": "Most the plan carries into the next plan year; capped by the IRS maximum for the year."
        },
        "run_out_end": {
          "$ref": "#/$defs/date",
          "description": "Last day to file claims for the plan year."
        },
        "balance": {
          "$ref": "#/$defs/money",
          "description": "Balance on balance_as_of, as the member entered it."
        },
        "balance_as_of": {
          "$ref": "#/$defs/date"
        },
        "eligible_categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "An HRA's eligible expense categories (ids from the Publication 502 table)."
        },
        "coverage": {
          "type": "array",
          "description": "HSA-eligible coverage periods for an HSA's contribution limit (TAX-06); default: from the HSA-eligible plans covering the holder.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "start": {
                "$ref": "#/$defs/date"
              },
              "end": {
                "$ref": "#/$defs/date"
              },
              "type": {
                "enum": [
                  "self_only",
                  "family"
                ]
              }
            }
          }
        },
        "last_month_rule_years": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Tax years the HSA's limit uses the last-month rule instead of monthly pro rata."
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "provider": {
      "type": "object",
      "description": "Anyone you pay for health spend: practice, hospital, lab, pharmacy or retailer. Shown and edited on the Settings page.",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "physician_practice",
            "hospital",
            "lab",
            "imaging",
            "pharmacy",
            "retailer",
            "other"
          ]
        },
        "network_status": {
          "$ref": "#/$defs/network_status"
        },
        "npi": {
          "type": "string",
          "pattern": "^[0-9]{10}$",
          "description": "Public National Provider Identifier, optional."
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names this provider appears under in source files (insurer 'Provided By', card-statement merchant). Used by importers to map rows to this provider."
        },
        "member_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Members this provider is known to serve, set by the owner. Relationships seen on claims are derived from visits and need not be listed."
        }
      }
    },
    "visit": {
      "type": "object",
      "description": "One encounter or purchase. The unit the app reconciles.",
      "required": [
        "id",
        "date",
        "provider_id",
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "member_id": {
          "$ref": "#/$defs/id"
        },
        "plan_id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": [
            "provider_visit",
            "service",
            "supplements",
            "rx",
            "equipment"
          ]
        },
        "description": {
          "type": "string"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "payment_path": {
          "enum": [
            "insurance",
            "self_pay"
          ],
          "description": "Whether the visit goes through insurance. Default: insurance for provider visits and services, none for supplements, equipment and prescriptions (REC-05, ADR-017)."
        },
        "dispute": {
          "type": "object",
          "additionalProperties": false,
          "description": "The minimal dispute of Release 1 (ADR-035), read as a case. New edits write `cases` instead (ADR-042).",
          "required": [
            "status",
            "opened"
          ],
          "properties": {
            "status": {
              "enum": [
                "open",
                "closed"
              ]
            },
            "opened": {
              "$ref": "#/$defs/date"
            },
            "closed": {
              "$ref": "#/$defs/date"
            },
            "note": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          }
        },
        "closed_findings": {
          "type": "array",
          "description": "Findings the member closed (dealt with, or accepted when closing a dispute), with whether each was a real problem or wrong.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "amount"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "amount": {
                "$ref": "#/$defs/money"
              },
              "closed": {
                "$ref": "#/$defs/date"
              },
              "how": {
                "type": "string"
              },
              "verdict": {
                "enum": [
                  "real",
                  "wrong"
                ],
                "description": "The member's word on the finding: a real problem, or wrong (a false positive; PLT-02, ADR-044)."
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "description": "The finding's kind (or its check code) when it was closed."
              },
              "release": {
                "type": "string",
                "description": "The release that showed the finding, e.g. release-1."
              }
            }
          }
        },
        "documents": {
          "type": "object",
          "description": "The member's choices for the document checklist (MAT-10): a document kind marked expected or not applicable.",
          "propertyNames": {
            "enum": [
              "bill",
              "itemized_bill",
              "eob",
              "receipt",
              "payment"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "expected",
                  "not_applicable"
                ]
              },
              "since": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "good_faith_estimate": {
          "$ref": "#/$defs/money",
          "description": "The provider's good-faith estimate for a self-pay visit (No Surprises Act). A bill above it is a finding; $400 or more above it starts the 120-day patient-provider dispute window (DSP-05)."
        },
        "cases": {
          "type": "array",
          "description": "Dispute cases the member opened on this visit (DSP-01, DSP-04, DSP-07; ADR-042).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "opened",
              "status"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "opened": {
                "$ref": "#/$defs/date"
              },
              "status": {
                "enum": [
                  "open",
                  "contacted",
                  "waiting",
                  "resolved"
                ]
              },
              "party": {
                "enum": [
                  "provider",
                  "insurer"
                ],
                "description": "Who the case is with."
              },
              "note": {
                "type": "string"
              },
              "follow_up_days": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365,
                "description": "Days after the last contact before a reminder (default 30)."
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "amount"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "amount": {
                      "$ref": "#/$defs/money"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                },
                "description": "The findings the case is about, as they were when it was opened."
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "charge": {
                      "$ref": "#/$defs/money"
                    },
                    "billed": {
                      "$ref": "#/$defs/money"
                    },
                    "patient_amount": {
                      "$ref": "#/$defs/money"
                    },
                    "patient_responsibility": {
                      "$ref": "#/$defs/money"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                },
                "description": "The bill and EOB lines that disagreed when the case was opened."
              },
              "history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date",
                    "status"
                  ],
                  "properties": {
                    "date": {
                      "$ref": "#/$defs/date"
                    },
                    "status": {
                      "enum": [
                        "open",
                        "contacted",
                        "waiting",
                        "resolved"
                      ]
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              },
              "outcome": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "result",
                  "recovered",
                  "date"
                ],
                "properties": {
                  "result": {
                    "enum": [
                      "corrected",
                      "refunded",
                      "written_off",
                      "denied",
                      "findings_wrong"
                    ]
                  },
                  "recovered": {
                    "$ref": "#/$defs/money"
                  },
                  "date": {
                    "$ref": "#/$defs/date"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "tax": {
          "type": "object",
          "additionalProperties": false,
          "description": "The member's tax choices for this visit (TAX-01, TAX-07): its Publication 502 category (with the table version it was chosen from), a letter of medical necessity on file, and an HSA payment marked as a mistake.",
          "properties": {
            "category": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "documentation": {
              "type": "boolean"
            },
            "mistake": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "document_base": {
      "type": "object",
      "required": [
        "id",
        "type",
        "date"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/date",
          "description": "Date on the document (statement date, processed date, payment date)."
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "match": {
          "$ref": "#/$defs/match"
        }
      }
    },
    "provider_bill": {
      "description": "A bill or statement from a provider. One line per visit it covers; a later statement may repeat earlier visits.",
      "allOf": [
        {
          "$ref": "#/$defs/document_base"
        }
      ],
      "required": [
        "provider_id",
        "balance_due",
        "lines"
      ],
      "properties": {
        "type": {
          "const": "provider_bill"
        },
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "due_date": {
          "$ref": "#/$defs/date"
        },
        "notice": {
          "type": "string",
          "description": "Notice wording printed on the statement, if any, e.g. \"Second notice\", \"Past due\", \"Final notice\"."
        },
        "balance_due": {
          "$ref": "#/$defs/money"
        },
        "network_status_shown": {
          "$ref": "#/$defs/network_status"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "visit_id",
              "patient_amount"
            ],
            "additionalProperties": false,
            "properties": {
              "visit_id": {
                "$ref": "#/$defs/id"
              },
              "description": {
                "type": "string"
              },
              "billed_charge": {
                "$ref": "#/$defs/money"
              },
              "insurance_paid": {
                "$ref": "#/$defs/money"
              },
              "adjustment": {
                "$ref": "#/$defs/money"
              },
              "rate": {
                "$ref": "#/$defs/money",
                "description": "Agreed rate as printed on the bill, if shown."
              },
              "patient_amount": {
                "$ref": "#/$defs/money",
                "description": "What the provider says you owe for this visit, before your payments."
              },
              "patient_paid": {
                "$ref": "#/$defs/money",
                "description": "Your payments the provider has credited to this visit."
              },
              "balance": {
                "$ref": "#/$defs/money",
                "description": "What is still owed on this visit after insurance and your payments."
              },
              "items": {
                "type": "array",
                "description": "Service lines for this visit as printed on the statement.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "rendering_provider": {
                      "type": "string"
                    },
                    "charge": {
                      "$ref": "#/$defs/money"
                    },
                    "adjustment": {
                      "type": "number",
                      "description": "Net insurance adjustment; reversals make it differ from the sum of postings."
                    },
                    "insurance_paid": {
                      "$ref": "#/$defs/money"
                    },
                    "patient_amount": {
                      "$ref": "#/$defs/money"
                    },
                    "patient_amount_type": {
                      "enum": [
                        "deductible",
                        "coinsurance",
                        "copay",
                        "not_covered",
                        "mixed",
                        "unknown"
                      ]
                    },
                    "patient_paid": {
                      "$ref": "#/$defs/money"
                    },
                    "balance": {
                      "$ref": "#/$defs/money"
                    },
                    "code": {
                      "type": "string",
                      "description": "CPT/HCPCS code with any modifier, e.g. 99214-25."
                    },
                    "service_date": {
                      "$ref": "#/$defs/date"
                    },
                    "units": {
                      "type": "number",
                      "minimum": 0
                    },
                    "write_off": {
                      "$ref": "#/$defs/money"
                    }
                  }
                }
              },
              "write_off": {
                "$ref": "#/$defs/money",
                "description": "Provider write-off after adjudication: prompt-pay discount, financial assistance, small balance (identity 3)."
              },
              "self_pay_discount": {
                "$ref": "#/$defs/money",
                "description": "Self-pay visits: the discount from the billed charge."
              },
              "match": {
                "$ref": "#/$defs/match"
              }
            }
          }
        },
        "last_payment_received": {
          "type": "object",
          "additionalProperties": false,
          "description": "The 'last payment received' box many statements print.",
          "properties": {
            "date": {
              "$ref": "#/$defs/date"
            },
            "method": {
              "type": "string"
            },
            "amount": {
              "$ref": "#/$defs/money"
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "eob": {
      "description": "Explanation of benefits: the insurer's decision on one visit's claim. Billed = insurer_paid + adjustment + additional_savings + patient_responsibility.",
      "allOf": [
        {
          "$ref": "#/$defs/document_base"
        }
      ],
      "required": [
        "plan_id",
        "provider_id",
        "visit_id",
        "billed",
        "allowed",
        "insurer_paid",
        "patient_responsibility"
      ],
      "properties": {
        "type": {
          "const": "eob"
        },
        "plan_id": {
          "$ref": "#/$defs/id"
        },
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "visit_id": {
          "$ref": "#/$defs/id"
        },
        "claim_number": {
          "type": "string"
        },
        "claim_status": {
          "enum": [
            "processed",
            "denied",
            "pending",
            "adjusted"
          ]
        },
        "received_date": {
          "$ref": "#/$defs/date",
          "description": "Date the insurer received the claim."
        },
        "network_status": {
          "$ref": "#/$defs/network_status"
        },
        "billed": {
          "$ref": "#/$defs/money"
        },
        "allowed": {
          "$ref": "#/$defs/money",
          "description": "The agreed (negotiated) rate for this claim."
        },
        "adjustment": {
          "$ref": "#/$defs/money",
          "description": "Contractual write-off: billed minus allowed, for in-network claims."
        },
        "insurer_paid": {
          "$ref": "#/$defs/money"
        },
        "additional_savings": {
          "$ref": "#/$defs/money",
          "description": "Other reductions some insurers report separately from the plan discount."
        },
        "deductible": {
          "$ref": "#/$defs/money"
        },
        "copay": {
          "$ref": "#/$defs/money"
        },
        "coinsurance": {
          "$ref": "#/$defs/money"
        },
        "not_covered": {
          "$ref": "#/$defs/money"
        },
        "patient_responsibility": {
          "$ref": "#/$defs/money",
          "description": "deductible + copay + coinsurance + not_covered."
        },
        "lines": {
          "type": "array",
          "description": "Service lines. Paired with the bill's lines and checked against the claim (MAT-06, REC-01).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "service_date": {
                "$ref": "#/$defs/date"
              },
              "description": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "description": "CPT/HCPCS code if printed."
              },
              "billed": {
                "$ref": "#/$defs/money"
              },
              "allowed": {
                "$ref": "#/$defs/money"
              },
              "insurer_paid": {
                "$ref": "#/$defs/money"
              },
              "patient_responsibility": {
                "$ref": "#/$defs/money"
              },
              "adjustment": {
                "$ref": "#/$defs/money"
              },
              "additional_savings": {
                "$ref": "#/$defs/money"
              },
              "secondary_paid": {
                "$ref": "#/$defs/money"
              },
              "deductible": {
                "$ref": "#/$defs/money"
              },
              "copay": {
                "$ref": "#/$defs/money"
              },
              "coinsurance": {
                "$ref": "#/$defs/money"
              },
              "not_covered": {
                "$ref": "#/$defs/money"
              },
              "units": {
                "type": "number",
                "minimum": 0
              },
              "remark_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Adjustment and remark codes printed on the line, e.g. CO-97 (bundled)."
              }
            }
          }
        },
        "secondary_paid": {
          "$ref": "#/$defs/money",
          "description": "Paid by a second plan under coordination of benefits (ALC-05). Zero with one plan."
        }
      },
      "unevaluatedProperties": false
    },
    "payment": {
      "description": "Money you paid to (or got back from) a provider. Applied to the provider's ledger, not to one visit; visit_ids is an optional hint.",
      "allOf": [
        {
          "$ref": "#/$defs/document_base"
        }
      ],
      "required": [
        "provider_id",
        "account_id",
        "amount"
      ],
      "properties": {
        "type": {
          "const": "payment"
        },
        "kind": {
          "enum": [
            "payment",
            "refund"
          ],
          "default": "payment"
        },
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "account_id": {
          "$ref": "#/$defs/id"
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "reference": {
          "type": "string",
          "description": "Confirmation or check number."
        },
        "visit_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "account_balance_after": {
          "$ref": "#/$defs/money",
          "description": "Account balance after this transaction, if the statement shows it."
        },
        "allocations": {
          "type": "array",
          "description": "How this payment is split across visits, when the member set it (ALC-04, MAT-07). Must add up to the amount.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "visit_id",
              "amount"
            ],
            "properties": {
              "visit_id": {
                "$ref": "#/$defs/id"
              },
              "amount": {
                "$ref": "#/$defs/money"
              }
            }
          }
        },
        "allocation_source": {
          "enum": [
            "member",
            "statement"
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "receipt": {
      "description": "Point-of-sale receipt for a purchase with no insurance claim (supplements, equipment, some Rx). Pair it with a payment.",
      "allOf": [
        {
          "$ref": "#/$defs/document_base"
        }
      ],
      "required": [
        "provider_id",
        "visit_id",
        "total"
      ],
      "properties": {
        "type": {
          "const": "receipt"
        },
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "visit_id": {
          "$ref": "#/$defs/id"
        },
        "total": {
          "$ref": "#/$defs/money"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "description",
              "amount"
            ],
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "quantity": {
                "type": "number",
                "minimum": 0
              },
              "amount": {
                "$ref": "#/$defs/money"
              }
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "account_reimbursement": {
      "description": "You paid out of pocket, then reimbursed yourself from an HSA or FSA. Clears the 'not paid from HSA' flag on those payments.",
      "allOf": [
        {
          "$ref": "#/$defs/document_base"
        }
      ],
      "required": [
        "from_account_id",
        "amount",
        "payment_ids"
      ],
      "properties": {
        "type": {
          "const": "account_reimbursement"
        },
        "from_account_id": {
          "$ref": "#/$defs/id"
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "payment_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "account_transaction": {
      "description": "Account activity that is not a payment to a provider: contributions, interest, fees, opening balance.",
      "allOf": [
        {
          "$ref": "#/$defs/document_base"
        }
      ],
      "required": [
        "account_id",
        "kind",
        "amount"
      ],
      "properties": {
        "type": {
          "const": "account_transaction"
        },
        "account_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "contribution_employee",
            "contribution_employer",
            "interest",
            "fee",
            "balance_forward",
            "transfer_in",
            "transfer_out",
            "other"
          ]
        },
        "amount": {
          "$ref": "#/$defs/money",
          "description": "Always positive; the kind gives the direction (fee and transfer_out reduce the balance)."
        },
        "description": {
          "type": "string"
        },
        "tax_year": {
          "type": "integer"
        },
        "account_balance_after": {
          "$ref": "#/$defs/money"
        }
      },
      "unevaluatedProperties": false
    },
    "member": {
      "type": "object",
      "description": "A household member who receives care. Shown and edited on the Settings page.",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "relationship": {
          "enum": [
            "self",
            "spouse",
            "child",
            "other"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names this member appears under in source files (e.g. claims 'Patient')."
        },
        "birth_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100,
          "description": "Year only: for the HSA 55+ catch-up and FSA rules for children under 27 (TAX-06, TAX-09)."
        },
        "tax_dependent": {
          "type": "object",
          "description": "Whether this member is a tax dependent, by tax year, e.g. {\"2026\": true} (TAX-09).",
          "propertyNames": {
            "pattern": "^[0-9]{4}$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "medicare_from": {
          "$ref": "#/$defs/date",
          "description": "First day of Medicare coverage; no HSA contributions from that month on (TAX-08)."
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "provider_relationship": {
      "type": "object",
      "description": "Two provider records that may be the same entity (different names on the claim and the card statement) or related. Tracked so matches are explicit, flagged until confirmed, and reconciled together.",
      "required": [
        "id",
        "provider_id",
        "related_provider_id",
        "relationship",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "related_provider_id": {
          "$ref": "#/$defs/id"
        },
        "relationship": {
          "enum": [
            "same_individual",
            "same_organization",
            "affiliated"
          ]
        },
        "status": {
          "enum": [
            "suspected",
            "confirmed",
            "rejected"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "plan_limit": {
      "type": "object",
      "description": "One cost-sharing limit, e.g. in-network family deductible $6,000. An individual limit with no member_id applies to each covered member; with member_id it applies to that member only.",
      "required": [
        "type",
        "network",
        "level",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "deductible",
            "out_of_pocket_max",
            "annual_maximum"
          ],
          "description": "annual_maximum is the most a plan pays per year (common on dental plans)."
        },
        "network": {
          "enum": [
            "in_network",
            "out_of_network",
            "combined"
          ]
        },
        "level": {
          "enum": [
            "individual",
            "family"
          ]
        },
        "member_id": {
          "$ref": "#/$defs/id"
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "provider_note": {
      "type": "object",
      "description": "A dated note about a provider: an email or call, what was said, what to follow up. Kept separately from imported documents so re-imports don't change it.",
      "required": [
        "id",
        "provider_id",
        "date",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "visit_id": {
          "$ref": "#/$defs/id",
          "description": "The visit the note is about, if any."
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "channel": {
          "enum": [
            "email",
            "phone",
            "portal",
            "in_person",
            "letter",
            "other"
          ]
        },
        "direction": {
          "enum": [
            "sent",
            "received",
            "note"
          ],
          "description": "sent: you contacted them; received: they contacted you; note: your own note."
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "case_id": {
          "$ref": "#/$defs/id",
          "description": "The dispute case (on the visit) the note belongs to."
        },
        "party": {
          "enum": [
            "provider",
            "insurer"
          ],
          "description": "Who the contact was with (default the provider)."
        },
        "person": {
          "type": "string",
          "description": "Who you spoke to or heard from."
        },
        "reference": {
          "type": "string",
          "description": "A call or case reference number they gave."
        },
        "outcome": {
          "type": "string",
          "description": "What was agreed or said. Required for a phone call on a case."
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "description": "How a document (or a statement line) was linked to its visit (MAT-05). status: auto (score 0.9 or more), proposed (0.6 to 0.9, the member confirms), confirmed (the member chose it). rejected lists visits the member said it isn't for; matching never proposes them again.",
      "properties": {
        "status": {
          "enum": [
            "auto",
            "proposed",
            "confirmed"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
